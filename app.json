{
  "expo": {
    "name": "GYM PAGLU",
    "slug": "gym-paglu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "gym-paglu",
    "backgroundColor": "#1A1A1A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gympaglu.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1A1A1A"
      },
      "package": "com.gympaglu.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow GYM PAGLU to use Face ID for attendance"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GYM PAGLU to access your camera"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GYM PAGLU to access your photos"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FFD600"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A1A1A"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
